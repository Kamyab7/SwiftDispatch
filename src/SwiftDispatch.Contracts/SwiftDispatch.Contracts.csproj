<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <Description>Contracts for SwiftDispatch requests, pipelines, and notifications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>swiftdispatch-icon-128.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo/swiftdispatch-icon-128.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
