<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TrueMediator" VersionOverride="$(Version)" />
    <PackageReference Include="TrueMediator.EntityFrameworkCore" VersionOverride="$(Version)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <Compile Include="../../samples/TrueMediator.Sample.EntityFrameworkCore/**/*.cs"
             Exclude="../../samples/TrueMediator.Sample.EntityFrameworkCore/obj/**/*.cs;../../samples/TrueMediator.Sample.EntityFrameworkCore/bin/**/*.cs"
             Link="Sample/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
